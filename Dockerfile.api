# Production Dockerfile for Nagrik Setu Backend API
FROM node:20-alpine AS builder

WORKDIR /app

# Copy monorepo dependency manifests
COPY package*.json ./
COPY packages/shared/package*.json ./packages/shared/
COPY packages/domain/package*.json ./packages/domain/
COPY apps/api/package*.json ./apps/api/

# Install dependencies
RUN npm ci

# Copy workspace source files
COPY tsconfig.json ./
COPY packages/shared ./packages/shared
COPY packages/domain ./packages/domain
COPY apps/api ./apps/api

# Build shared, domain, and api
RUN npm run build --workspace=@nagrik-setu/shared
RUN npm run build --workspace=@nagrik-setu/domain
RUN npm run build --workspace=@nagrik-setu/api

# Production Runner Stage
FROM node:20-alpine AS runner

WORKDIR /app
ENV NODE_ENV=production
ENV PORT=4000

COPY --from=builder /app/package*.json ./
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/packages/shared ./packages/shared
COPY --from=builder /app/packages/domain ./packages/domain
COPY --from=builder /app/apps/api ./apps/api

EXPOSE 4000

CMD ["node", "apps/api/dist/server.js"]
