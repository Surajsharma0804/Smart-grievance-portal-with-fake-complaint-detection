# Application
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
API_BASE_URL=http://localhost:4000
CLIENT_ORIGIN=http://localhost:3000

# Authentication
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-chars
SESSION_VERIFY_SECRET=change-me-session-verify-secret
SSE_TICKET_SECRET=change-me-sse-ticket-secret

# Database
MONGO_URI=mongodb://localhost:27017/nagrik-setu?replicaSet=rs0
REDIS_URL=redis://localhost:6379

# Storage (local | s3)
STORAGE_DRIVER=local
STORAGE_PATH=./uploads
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# AI Provider (mock | gemini | claude | openai)
AI_PROVIDER=mock
AI_API_KEY=

# Embedding Provider (mock | clip | remote | caption)
EMBEDDING_PROVIDER=mock

# Worker
RUN_WORKER=1

# Sentry (optional in dev)
SENTRY_DSN=

# Duplicate detection
DUP_RADIUS_M=150
DUP_WINDOW_DAYS=30
DUP_HIGH=0.82
DUP_GREY=0.65

# Trust scoring
TRUST_PASS=70
TRUST_REVIEW=40

# Resolution
RESOLVE_RADIUS_M=200
